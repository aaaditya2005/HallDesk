NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRE=7d

# Required only when running the corresponding seed script.
# ADMIN_SEED_PASSWORD=set-a-strong-one-off-password
# WARDEN_SEED_PASSWORD=set-a-strong-one-off-password

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Comma-separated exact browser origins. Required in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set true when the app is behind one trusted reverse proxy.
TRUST_PROXY=false

# Optional direct HTTPS mode. Use a reverse proxy in most production deployments.
# HTTPS_KEY_PATH=/absolute/path/to/tls/private.key
# HTTPS_CERT_PATH=/absolute/path/to/tls/certificate.crt
# If TLS is terminated by a trusted reverse proxy, set this instead of certificate paths.
# HTTPS_TERMINATED_AT_PROXY=true